{
  "id": "clean-print",
  "name": "Clean Print",
  "version": "1.0.0",
  "description": "Theme-independent printing with a subtle sidebar button and simple PDF options.",
  "author": "Kolten Bendickson",
  "slots": { "common.footer": "templates/config.njk" },
  "styles": ["styles/clean-print.css"],
  "scripts": ["assets/clean-print.js"],
  "settings": [
    { "key": "includeTitle", "name": "Include note name by default", "type": "boolean", "default": true },
    { "key": "pageNumbers", "name": "Include page numbers by default", "type": "boolean", "default": true },
    { "key": "rememberOptions", "name": "Remember visitor print options", "type": "boolean", "default": true }
  ]
}
